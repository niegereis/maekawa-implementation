      "link": null,
      "locked": false,
      "text": "Client.access\nRequestId (clientId, seq)\nclock.tick()\nACQUIRE_REQ ao TARGET\nbloqueia até COMMITTED\nTIMEOUT encerra a rodada",
      "fontSize": 15,
      "fontFamily": 2,
      "textAlign": "left",
