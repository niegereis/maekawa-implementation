      "link": null,
      "locked": false,
      "text": "ROLE = node\npid por PROCESS_ID ou HOSTNAME sync-i\nVARIANT, SYNC_ENABLED, CS_MIN_MS, CS_MAX_MS\nQuorum.fano() e TcpTransport na porta 7000\nDeliveryGate só quando GATE_HOLD tem regra\nNode.start() e fica vivo até o pod encerrar",
      "fontSize": 15,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "ROLE = node\npid por PROCESS_ID ou HOSTNAME sync-i\nVARIANT, SYNC_ENABLED, CS_MIN_MS, CS_MAX_MS\nQuorum.fano() e TcpTransport na porta 7000\nDeliveryGate só quando GATE_HOLD tem regra\nNode.start() e fica vivo até o pod encerrar",
      "autoResize": true,
      "lineHeight": 1.25
    },
