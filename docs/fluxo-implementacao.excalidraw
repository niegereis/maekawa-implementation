      "link": null,
      "locked": false,
      "text": "ROLE = client\nCLIENT_ID ou JOB_COMPLETION_INDEX\nTARGET = sync-i, ACCESSES pedidos\nClient.run() com TcpTransport na porta 0\nthink e timeout, ou a lista *_BY_CLIENT\ncódigo 1 se algum pedido estourar o tempo",
      "fontSize": 15,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "ROLE = client\nCLIENT_ID ou JOB_COMPLETION_INDEX\nTARGET = sync-i, ACCESSES pedidos\nClient.run() com TcpTransport na porta 0\nthink e timeout, ou a lista *_BY_CLIENT\ncódigo 1 se algum pedido estourar o tempo",
      "autoResize": true,
