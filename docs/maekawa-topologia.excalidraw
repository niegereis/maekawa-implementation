      "text": "cada nó está em 3 triângulos;\ndois triângulos dividem 1 nó",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "cada nó está em 3 triângulos;\ndois triângulos dividem 1 nó",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b1c"
    },
    {
