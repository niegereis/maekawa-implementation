      "index": "b3o"
    },
    {
      "id": "ic8rbqpsztx4jh97",
      "type": "text",
      "x": 1550,
      "y": 810,
      "width": 305.76000000000005,
      "height": 32.5,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
