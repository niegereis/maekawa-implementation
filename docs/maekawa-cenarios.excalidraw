    {
      "id": "mlz16ufzgli4upaq",
      "type": "text",
      "x": 985,
      "y": 1070,
      "width": 394.24,
      "height": 357.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
